# Application Configuration
NODE_ENV=development
PORT=4000
API_PREFIX=api
APP_NAME="NestApp Service"
APP_TIMEZONE=UTC

# Database: mysql | mariadb | postgres (aliases: postgresql, pgsql)
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=root
DB_NAME=startkit12_db
# DB_SYNCHRONIZE=true
# DB_LOGGING=false

# PostgreSQL example:
# DB_DRIVER=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASS=postgres
# DB_NAME=nest_db

# Seed defaults (npm run seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Password123!
SEED_ADMIN_NAME=Admin

# Mongodb
MONGO_URI=mongodb://localhost:27017/sample_db

# Log Configuration
LOG_DIR=storage/logs
LOG_FILE=storage/logs/nestapp.log

# JWT Configuration
JWT_SECRET=OMS-7f2c9a8e4b1d6c0a9f3e2d4a6b8c1e5f0a7d9c2b4e6f8a1c3d5e7b9a0c2
JWT_EXPIRES_IN=60m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Mail Configuration
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
